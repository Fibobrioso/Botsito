{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git merge --no-verify*)",
      "Bash(git merge * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :refs/tags/*)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf ./data*)",
      "Bash(rm -rf corpus*)",
      "Bash(rm -rf ./corpus*)",
      "Bash(rm -rf knowledge*)",
      "Bash(rm -rf ./knowledge*)",
      "Bash(rm -fr data*)",
      "Bash(rm -fr corpus*)",
      "Bash(rm -fr knowledge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
