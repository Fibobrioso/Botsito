{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)"
    ],
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git merge --no-verify*)",
      "Bash(git merge * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git push * --delete main*)",
      "Bash(git push * --delete stable/*)",
      "Bash(git push * --delete refs/tags/*)",
      "Bash(git push * --delete refs/heads/main*)",
      "Bash(git push * --delete * main*)",
      "Bash(git push * --delete * stable/*)",
      "Bash(git push * --delete * refs/tags/*)",
      "Bash(git push * --delete * refs/heads/main*)",
      "Bash(git push * -d main*)",
      "Bash(git push * -d stable/*)",
      "Bash(git push * -d refs/tags/*)",
      "Bash(git push * -d refs/heads/main*)",
      "Bash(git push * -d * main*)",
      "Bash(git push * -d * stable/*)",
      "Bash(git push * -d * refs/tags/*)",
      "Bash(git push * -d * refs/heads/main*)",
      "Bash(git push * :main*)",
      "Bash(git push * :stable/*)",
      "Bash(git push * :refs/tags/*)",
      "Bash(git push * :refs/heads/main*)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf ./data*)",
      "Bash(rm -rf corpus*)",
      "Bash(rm -rf ./corpus*)",
      "Bash(rm -rf knowledge*)",
      "Bash(rm -rf ./knowledge*)",
      "Bash(rm -fr data*)",
      "Bash(rm -fr corpus*)",
      "Bash(rm -fr knowledge*)",
      "Artifact",
      "ArtifactData",
      "DesignSync",
      "mcp__claude-in-chrome__file_upload",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/estado_sesion.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
